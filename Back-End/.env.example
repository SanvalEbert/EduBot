# Configuração do EduBot — copie para .env e ajuste.
#
# Por padrão a IA é MOCKADA (sem custo, determinística). Para ligar o Claude
# real na AWS Bedrock, troque o provider e informe as credenciais da AWS.

# Provider da LLM: mock | bedrock | anthropic
EDUBOT_LLM_PROVIDER=mock

# Modelo Claude (sem o prefixo "anthropic." — ele é adicionado na Bedrock).
# Opções: claude-sonnet-4-6 (econômico) | claude-opus-4-8 (mais capaz)
EDUBOT_LLM_MODEL=claude-sonnet-4-6
EDUBOT_LLM_MAX_TOKENS=1024

# --- AWS Bedrock (quando EDUBOT_LLM_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
# Credenciais da AWS (ou use um perfil/role; nesse caso não precisa destas):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- API direta da Anthropic (quando EDUBOT_LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=

# Segredo para assinar os tokens de sessão (defina em produção)
# EDUBOT_SECRET=
