# ===========================================================================
# EduBot — modelo de variáveis de ambiente (copie para `.env` na raiz).
# O compose.yaml carrega o `.env` automaticamente. Sem `.env`, os defaults
# (modo mock, sem custo) valem. NÃO comite o `.env` real (segredos).
# ===========================================================================

# --- Banco (A4) ------------------------------------------------------------
DB_HOST=ova_mysql
DB_PORT=3306
DB_NAME=ova_db
DB_USER=eduardo
DB_PASSWORD=Password-1

# --- Segurança (A18 / A.3) -------------------------------------------------
# Segredo para assinar tokens de sessão. DEFINA em produção.
EDUBOT_SECRET=dev-secret-change-me
# Origem(ns) do frontend permitidas no CORS (vírgula separa; "*" só em dev).
EDUBOT_CORS_ORIGINS=http://localhost:8010
# Rate-limit do login (A.3): tentativas por janela (segundos).
EDUBOT_LOGIN_MAX_ATTEMPTS=5
EDUBOT_LOGIN_WINDOW_SECONDS=60

# --- Proatividade agendada (A13) -------------------------------------------
EDUBOT_SCHEDULER=on
EDUBOT_SCHEDULER_HOUR=3
# EDUBOT_SCHEDULER_INTERVAL_MINUTES=10   # modo demo: roda a cada N min

# --- IA (Bedrock/Anthropic) — padrão MOCK (sem custo) ----------------------
# Ligue o Claude real definindo o provider + credenciais.
EDUBOT_LLM_PROVIDER=mock                  # mock | bedrock | anthropic
EDUBOT_LLM_MAX_TOKENS=1024

# Bedrock exige INFERENCE PROFILE (prefixo us./global.) — modelos recentes NÃO
# aceitam invocação on-demand pelo id "anthropic.<modelo>". Liste os válidos com:
#   docker exec ova_back_end python -c "import boto3;print([p['inferenceProfileId'] \
#     for p in boto3.client('bedrock',region_name='us-east-1').list_inference_profiles()['inferenceProfileSummaries'] if 'anthropic' in p['inferenceProfileId']])"
EDUBOT_LLM_MODEL=us.anthropic.claude-sonnet-4-6                 # tool-use / recomendação
EDUBOT_COACH_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0  # fala do coach (barato)
AWS_REGION=us-east-1

# Autenticação Bedrock — escolha UMA:
#  (a) API key / bearer token (o SDK a lê como api_key). Pode ser temporária (~12h):
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
#  (b) credenciais SigV4:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                      # só p/ credenciais temporárias

# Alternativa: API direta da Anthropic (EDUBOT_LLM_PROVIDER=anthropic), ids sem
# prefixo (ex.: claude-sonnet-4-6):
# ANTHROPIC_API_KEY=

# --- Observabilidade / custo do agente (B.2) -------------------------------
# Teto diário estimado de gasto com LLM (USD). 0 = desligado. Ao atingir, os
# caminhos de LLM degradam para template determinístico (usado em B.4/B.5).
EDUBOT_DAILY_BUDGET_USD=1.00

# --- Agente Etapa 4 (B.4) --------------------------------------------------
# Redator da intervenção por caso (modelo barato) + circuit breaker do provider.
# Sem EDUBOT_REDACTOR_MODEL, o redator HERDA o EDUBOT_COACH_MODEL (mesmo papel
# de Haiku barato). Na Bedrock, use o id de INFERENCE PROFILE (us....-v1:0).
EDUBOT_REDACTOR_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
EDUBOT_REDACTOR_MAX_TOKENS=250
EDUBOT_LLM_BREAKER_THRESHOLD=3          # falhas consecutivas p/ abrir o breaker
EDUBOT_LLM_BREAKER_COOLDOWN=600         # segundos degradando p/ template/mock

# --- Voz do EduBot (V.1 — AWS Polly) ---------------------------------------
# Requer credencial com polly:SynthesizeSpeech (a Bedrock API key NÃO cobre voz).
# Sem ela, /edubot/speak devolve available:false e o front usa Web Speech.
EDUBOT_SPEECH=auto                      # auto | off (off força o fallback)
EDUBOT_POLLY_VOICE_PT=Camila
EDUBOT_POLLY_VOICE_EN=Joanna
EDUBOT_SPEECH_CACHE_DIR=./speech_cache

# --- Gamificação (Etapa 8, Plano 2) ----------------------------------------
# "off" desliga a camada inteira: award/register viram no-op e o front esconde a
# UI (a plataforma fica idêntica à atual). Curva de nível e tamanho do ranking.
EDUBOT_GAMIFICATION=on                  # on | off
EDUBOT_XP_LEVEL_BASE=60                 # level = 1 + floor(sqrt(xp/base))
EDUBOT_LEADERBOARD_SIZE=10

# --- Companheiro de estudo no OVA (Etapa 11, Plano 3) ----------------------
# "off" faz o leitor de OVA NÃO montar o personagem (saudação/reações/ouvir a
# seção somem; o leitor fica idêntico ao atual). Exposto em /student/me.
EDUBOT_COMPANION=on                     # on | off

# --- Integracao externa: API publica /api/v1 (migration_021) ---------------
# Chaves de parceiro ficam na tabela `api_keys`; emita com:
#   docker exec -it ova_back_end python -m tools.apikey_tool criar #       --nome "Parceiro X" --escopos catalog:read,tracking:read --dias 90
#
# Salt da pseudonimizacao do aluno. O parceiro recebe `subject_id` (hash estavel
# e opaco) no lugar do student_id. Sem valor o pseudonimo continua estavel, mas
# e' derivavel por quem conhece o esquema -> DEFINA em producao.
#   python -c "import secrets; print(secrets.token_hex(32))"
EDUBOT_PSEUDONYM_SALT=
# Teto de requisicoes por chave, por janela (segundos).
EDUBOT_APIKEY_RATE_LIMIT=120
EDUBOT_APIKEY_RATE_WINDOW=60
# Coleta pelo edubot-tracker.js: origens liberadas no CORS (CSV; "*" = todas,
# inclusive file://) e teto de requisicoes por chave de coleta, por janela.
EDUBOT_COLLECT_ORIGINS=*
EDUBOT_COLLECT_RATE_LIMIT=600

# --- Debug -----------------------------------------------------------------
EDUBOT_DEBUG=0
